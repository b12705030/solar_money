# PostgreSQL 連線字串（Neon serverless 或任何 PostgreSQL）
# 格式：postgresql://user:password@host/dbname?sslmode=require
# 到 https://neon.tech/ 建立免費資料庫後取得
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT 簽名密鑰 — 用來簽發與驗證登入 token
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
# 未設定：後端自動產生臨時 key，每次重啟後所有用戶 token 失效（本地開發可接受）
JWT_SECRET=

# 管理員 API secret — 呼叫 /api/admin/* 時帶在 X-Admin-Secret header
# 可自訂任意字串，例如：solar-admin-2026-yourname
# 正式環境必須設定，否則後端拒絕啟動
ADMIN_SECRET=

# 本地開發用：允許使用預設 admin secret（ADMIN_SECRET 未設時才生效）
# 正式環境絕對不可設此旗標
ALLOW_DEV_ADMIN_SECRET=1

# Cloudflare R2 — 廠商 logo 儲存
# 到 Cloudflare Dashboard > R2 > 建立 bucket，再建立 API Token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=solar-money-logos
# bucket 啟用公開存取後的 Public URL，例如 https://pub-xxx.r2.dev
R2_PUBLIC_URL=

# 允許的前端來源（CORS），逗號分隔
# 部署後填入 Vercel domain，例如：https://your-app.vercel.app,http://localhost:3000
# 未設定：允許所有來源（本地開發可不設）
CORS_ORIGINS=
